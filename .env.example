# ==============================================================================
# EXITLENS — LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# Steel Strips Wheels Limited — Employee Exit Intelligence Platform
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL 14+)
# When unset or empty, ExitLens gracefully operates in resilient In-Memory/LocalStorage Mode.
# To connect a local PostgreSQL database, start Postgres and set the connection string:
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exitlens_dev

# Optional Connection Pool Limits
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (Development Mode)
# In production, ExitLens connects to enterprise SAML 2.0 / OIDC identity providers.
# In local development, the built-in DevAuth system simulates 4 enterprise roles.
# ------------------------------------------------------------------------------
AUTH_MODE=development
NEXT_PUBLIC_DEV_AUTH_ENABLED=true
JWT_SECRET=super-secret-dev-key-change-in-production-min-32-chars-long

# ------------------------------------------------------------------------------
# AUDIT & COMPLIANCE
# ------------------------------------------------------------------------------
ENABLE_STRICT_AUDIT_LOGS=true
SCRUB_SENSITIVE_REMARKS_FROM_AUDIT=true
